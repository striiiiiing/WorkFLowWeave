{
  "id": "business_github",
  "transport": "stdio",
  "command": "github-mcp-server",
  "args": ["stdio", "--read-only", "--tools", "get_file_contents,issue_read,search_issues,pull_request_read"],
  "env": {
    "GITHUB_PERSONAL_ACCESS_TOKEN": {"kind": "env", "name": "GITHUB_PERSONAL_ACCESS_TOKEN"}
  },
  "timeout": 120
}
