BACKEND_TOOLS_IMAGE=ghcr.io/striiiiiing/workflowweave-backend:tools
FRONTEND_IMAGE=ghcr.io/striiiiiing/workflowweave-frontend:latest
FRONTEND_PORT=3000
REFERENCES_PATH=./data/references
