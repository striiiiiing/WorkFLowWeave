# Change deployment settings here; application configuration lives in the state volume.
BACKEND_IMAGE=ghcr.io/striiiiiing/workflowweave-backend:latest
FRONTEND_IMAGE=ghcr.io/striiiiiing/workflowweave-frontend:latest
ALL_IN_ONE_IMAGE=ghcr.io/striiiiiing/workflowweave-backend:full
FRONTEND_PORT=3332
REFERENCES_PATH=./data/references
