{
  "name": "logagent-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src tests *.ts *.json index.html README.md",
    "format:check": "prettier --check src tests *.ts *.json index.html README.md",
    "test:e2e": "playwright test",
    "test:live": "playwright test --config playwright.live.config.ts",
    "screenshot:tabbit": "node scripts/capture_tabbit.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ajv-i18n": "^4.2.0",
    "axios": "^1.20.0",
    "element-plus": "^2.11.0",
    "fast-deep-equal": "^3.1.3",
    "lucide-vue-next": "^0.468.0",
    "markdown-it": "^15.0.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.13.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.2",
    "prettier": "^3.9.8",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.1.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^2.2.0"
  }
}
